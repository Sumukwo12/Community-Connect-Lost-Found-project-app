# Community Connect - Environment Configuration Example
# Copy this file to env.php and fill in your actual values
# NEVER commit env.php to version control

DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_PORT=3306

APP_NAME=Community Connect
APP_ENV=production
APP_SECRET=change_this_to_a_long_random_string_at_least_64_chars
APP_URL=https://lost.strand.co.ke

UPLOAD_DIR=uploads/items/
MAX_FILE_SIZE=5242880
ALLOWED_ORIGINS=https://yourapp.example.com

TOKEN_LIFETIME_DAYS=30
